# Docker (read by docker-compose.yml's env_file)
POSTGRES_USER=admin
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=chongkran

# Database (read by NuxtHub hub.db driver)
DATABASE_DRIVER=postgres-js
DATABASE_URL=postgresql://admin:supersecret@localhost:5432/chongkran

# Redis (NuxtHub KV driver)
REDIS_URL=redis://localhost:6379

# Auth
NUXT_BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend — requires verified domain in prod)
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Chongkran <noreply@chongkran.local>

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
